# Release signing config. Copy this file to `android/key.properties`
# (which is git-ignored) and fill in real values. NEVER commit key.properties
# or the .jks keystore itself.
#
# 1. Generate a release keystore (keep the .jks OUTSIDE the repo):
#      keytool -genkey -v -keystore ~/autopodbor-release.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias autopodbor
#
# 2. Copy this file and fill in the values below.
#
# When android/key.properties is absent, release builds fail fast. For a local
# release run with debug signing only, pass -Pandroid.allowDebugSigning=true.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=autopodbor
storeFile=/absolute/path/to/autopodbor-release.jks
